.vscode/

# Secrets & local environment (never bake credentials into images)
.env
.env.*
!.env.example
bot/.env
**/.env
bot/Service Account.json
*.pem
*.key

# Backups, logs & temporary files
backups/
*.log
*.tmp
*.temp
media_*.png
