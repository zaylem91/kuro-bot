# Virtual environments
venv/
.venv/
env/

# Python cache & compiled bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Version control & configuration
.git/
.gitignore
.github/
