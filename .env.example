# === Kuro Bot - Environment Variables ===
# Copy this file to .env or bot/.env and fill with real values
# NEVER commit .env with real secrets - it's in .gitignore

# Optional - Team / Bot Name (used in webhooks, dashboard, and embeds)
# TEAM_NAME=Kuro

# Required - Discord
# DISCORD_TOKEN=your_discord_bot_token_here
# TEAM_LEADER_ROLE_ID=123456789
# ADMIN_ROLE_ID=987654321
# DATABASE_URL=postgresql://user:password@localhost:5432/kuro_db
GUILD_ID=123456789

# Required - Google Drive
GOOGLE_SERVICE_ACCOUNT_JSON=bot/Service Account.json
DRIVE_ROOT_FOLDER_ID=your_drive_folder_id_here

# Required - Discord Roles (for auto-assign on /register)
TL_ROLE_ID=111111111
PR_ROLE_ID=222222222
ED_ROLE_ID=333333333

# Manga Categories per status (ongoing / paused / dropped)
MANGA_CATEGORY_NAME=📚 Mangas
MANGA_CATEGORY_ID=
MANGA_CATEGORY_PAUSED_NAME=⏸️ Paused Mangas
MANGA_CATEGORY_PAUSED_ID=
MANGA_CATEGORY_DROPPED_NAME=❌ Dropped Mangas
MANGA_CATEGORY_DROPPED_ID=

# Optional - Emojis (already configured in code, override only if you re-upload in Developer Portal)
EMOJI_GDRIVE_ID=1545051179548020837
EMOJI_MANGA_ID=1545051221205717063
EMOJI_TL_ID=1545051534016913408
EMOJI_ED_ID=1545051667202965504
EMOJI_PR_ID=1545052442515734629
EMOJI_LINK_ID=1545052667045486622
EMOJI_STATUS_ID=1545103772395634820

# Optional - Override other emojis (see bot/config.py EMOJI dict)
# EMOJI_BOOK_ID=1545434395609923674
# EMOJI_STAFF_ID=1545433601200496690
# EMOJI_MONEYBAG_ID=1545433562331746355

# Optional - Dashboard Media GIFs (moved from hard-coded code to env)
GIPHY_ADMIN_MAIN=https://media.giphy.com/media/1nVSfqbKaL2OYkZq8V/giphy.gif
GIPHY_MANGA_HUB=https://media.giphy.com/media/DAAwYcL6rhvArpF3FL/giphy.gif
GIPHY_STAFF_HUB=https://media.giphy.com/media/IzR9o1CxrNYTU1g71p/giphy.gif
GIPHY_FINANCE_HUB=https://media.giphy.com/media/12Eo7WogCAoj84/giphy.gif
GIPHY_STAFF_DASHBOARD=https://media.giphy.com/media/iXufGF6kBkWWJjnWiV/giphy.gif

# Optional - Timezone
# MONTHLY_TIMEZONE=UTC

# Optional - Health server (/health, /metrics)
# Code default is 0.0.0.0:8080. For local dev you may prefer 127.0.0.1.
# docker-compose.yml already sets HEALTH_HOST=0.0.0.0 + publishes HEALTH_PORT.
# HEALTH_PORT=8080
# HEALTH_HOST=0.0.0.0
# HEALTH_TOKEN=  # optional Bearer token for /health and /metrics (if set, requests need Authorization: Bearer <token>)

# === Remote Dashboard (HTML control panel — http://SERVER:8080/dashboard) ===
# REQUIRED to enable /api/* — generate a strong token with:
#   python scripts/generate_dashboard_token.py
# DASHBOARD_TOKEN=PASTE_GENERATED_TOKEN_HERE
# Optional hardening:
# DASHBOARD_ALLOWED_IPS=  # comma-separated IPs allowed, e.g. "1.2.3.4,5.6.7.8" (empty = any IP, token still required)
# DASHBOARD_CORS_ORIGINS=*  # lock down in production, e.g. "https://dashboard.example.com"

# Optional - Sentry for error tracking
# SENTRY_DSN=https://your-sentry-dsn

# Optional - Backup
# BACKUP_CRON=0 3 * * *  # daily at 3am via external cron calling scripts/backup.py
